<?xml version="1.0" ?>
<robot name="aubot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ==================== Materials ==================== -->
  <material name="dark_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.2 0.8 1.0"/>
  </material>

  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ==================== Base Footprint (ground) ==================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Base Link (flat disk) ==================== -->
  <!-- Cylinder: radius=0.20m, height=0.005m                          -->
  <!-- Center at z=0.08 from ground (wheel axle height)               -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.20" length="0.005"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.20" length="0.005"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="1.5003e-02" ixy="0" ixz="0"
               iyy="1.5003e-02" iyz="0"
               izz="3.0000e-02"/>
    </inertial>
  </link>

  <!-- ==================== Left Wheel ==================== -->
  <!-- Cylinder: radius=0.08m, width=0.008m                 -->
  <!-- Positioned at disk edge: y = disk_radius + half_width -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.204 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1.6053e-04" ixy="0" ixz="0"
               iyy="1.6053e-04" iyz="0"
               izz="3.2000e-04"/>
    </inertial>
  </link>

  <!-- ==================== Right Wheel ==================== -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.204 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.008"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1.6053e-04" ixy="0" ixz="0"
               iyy="1.6053e-04" iyz="0"
               izz="3.2000e-04"/>
    </inertial>
  </link>

  <!-- ==================== Caster Front (center) ==================== -->
  <!-- Positioned at front edge of disk, y=0 (between wheels)          -->
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.18 0 -0.0025" rpy="0 0 0"/>
  </joint>

  <link name="caster_front_link">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.005"/>
      </geometry>
      <material name="light_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.0725" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.0725"/>
      <mass value="0.005"/>
      <inertia ixx="1.0000e-04" ixy="0" ixz="0"
               iyy="1.0000e-04" iyz="0"
               izz="1.0000e-04"/>
    </inertial>
  </link>

  <!-- ==================== Caster Back (center) ==================== -->
  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.18 0 -0.0025" rpy="0 0 0"/>
  </joint>

  <link name="caster_back_link">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.005"/>
      </geometry>
      <material name="light_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.0725" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.0725"/>
      <mass value="0.005"/>
      <inertia ixx="1.0000e-04" ixy="0" ixz="0"
               iyy="1.0000e-04" iyz="0"
               izz="1.0000e-04"/>
    </inertial>
  </link>

  <!-- ==================== LiDAR Support Column ==================== -->
  <!-- From disk top (z=0.0025) to LiDAR bottom (z=0.08 rel base)    -->
  <!-- Column: r=0.01m, h=0.0775m, center at z=0.04125               -->
  <joint name="lidar_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_support_link"/>
    <origin xyz="0 0 0.04125" rpy="0 0 0"/>
  </joint>

  <link name="lidar_support_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0001" length="0.0775"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0001" length="0.0775"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.0000e-04" ixy="0" ixz="0"
               iyy="1.0000e-04" iyz="0"
               izz="1.0000e-04"/>
    </inertial>
  </link>

  <!-- ==================== LiDAR Sensor (base_scan) ==================== -->
  <!-- Cylinder: r=0.04m, h=0.04m                                        -->
  <!-- Center at z=0.10 rel base_link → z=0.18 from ground               -->
  <!-- Bottom at z=0.16 (column top), Top at z=0.20                      -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.114"/>
      <inertia ixx="1.0000e-03" ixy="0" ixz="0"
               iyy="1.0000e-03" iyz="0"
               izz="1.0000e-03"/>
    </inertial>
  </link>

</robot>
